APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
VITE_API_BASE_URL=/api/v1
PROVIDER_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
API_ACCESS_TOKEN=replace-with-a-strong-random-token-at-least-32-characters
SESSION_SIGNING_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
OPERATOR_SESSION_TTL_SECONDS=1800
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=replace-with-a-strong-random-database-password
DATABASE_URL=postgresql+psycopg://agentforge:replace-with-a-strong-random-database-password@localhost:5432/agentforge
TEST_DATABASE_URL=postgresql+psycopg://agentforge:replace-with-a-strong-random-database-password@localhost:5432/agentforge_test
